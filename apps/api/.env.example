# LLM fallback: DeepSeek direct API (api.deepseek.com/v1).
# Get key at https://platform.deepseek.com/api_keys
# Pricing (June 2026): deepseek-v4-flash $0.14/M in, $0.28/M out
# Leave empty to disable fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Embeddings fallback: Voyage AI direct API (api.voyageai.com/v1).
# Get key at https://dash.voyageai.com/
# Free tier: 200M tokens for voyage-4-lite.
# Leave empty to disable fallback (Qwen only).
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_MODEL=voyage-4-lite
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com/v2
COHERE_EMBED_MODEL=embed-v4.0
ALLOWED_ORIGINS=["https://your-domain.vercel.app"]
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=Kamilya LMS
SUPABASE_SIGNED_URL_TTL=300
STORAGE_BACKEND=local
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=generate-a-random-webhook-secret
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Kamilya LMS <no-reply@notify.kml.kz>
# Must equal Kamilya CRM's LMS_WEBHOOK_SECRET (32+ random characters in production). Leaving either value empty
# keeps lead events pending in the durable outbox; public lead acceptance continues.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
CERTIFICATE_STORAGE_DIR=storage/certificates

# SCORM import limits. Enforce a matching request-body limit at the ingress/proxy.
MAX_SCORM_ZIP_BYTES=262144000
MAX_SCORM_FILES=5000
MAX_SCORM_UNCOMPRESSED_BYTES=524288000
MAX_SCORM_ENTRY_BYTES=104857600
MAX_SCORM_COMPRESSION_RATIO=100
MAX_SCORM_MANIFEST_BYTES=2097152
