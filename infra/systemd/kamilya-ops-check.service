[Unit]
Description=Kamilya LMS production watchdog
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/kamilya/ops.env
ExecStart=/opt/kamilya-runtime/scripts/ops/healthcheck.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kamilya-ops
