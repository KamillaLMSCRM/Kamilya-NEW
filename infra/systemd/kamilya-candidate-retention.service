[Unit]
Description=Enforce expired Kamilya candidate-assessment retention
Requires=docker.service
After=docker.service network-online.target
ConditionPathExists=/var/run/docker.sock

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec kamilya-runtime-worker-ops-1 poetry run python -m app.modules.candidate_assessments.retention_recovery
TimeoutStartSec=5min
