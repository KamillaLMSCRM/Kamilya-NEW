# Non-secret KZ runtime inventory for kamilya-ops-check.service.
API_HEALTH_URL=https://api.kml.kz/api/v1/health
WEB_HEALTH_URL=https://app.kml.kz/login
EXPECTED_DEPLOYMENT_ENVIRONMENT=kz-production
EXPECTED_RELEASE_SHA=<exact-40-character-production-sha>
PRODUCTION_VERIFIER=/opt/kamilya-runtime/scripts/ops/verify_production_endpoint.py
COMPOSE_FILE=/opt/kamilya-runtime/kamilya-app-worker.yml
COMPOSE_ENV_FILE=/opt/kamilya-runtime/deploy.env
COMPOSE_PROJECT_NAME=kamilya-runtime
# A read-only local mirror/directory or freshness marker updated only after a
# verified encrypted CT125 database or VM126 blob backup succeeds.
BACKUP_FRESHNESS_PATH=<authoritative-kz-backup-evidence-path>
