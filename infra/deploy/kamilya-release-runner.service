[Unit]
Description=Kamilya protected GitHub release runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kamilya-release-runner
Group=kamilya-release-runner
WorkingDirectory=/opt/actions-runner
ExecStart=/opt/actions-runner/run.sh
Restart=always
RestartSec=10
PrivateTmp=true

[Install]
WantedBy=multi-user.target
