# Non-secret deployment selectors. Runtime credentials remain in the root-only
# file referenced by KAMILYA_ENV_FILE and must never be committed.
KAMILYA_API_IMAGE=kamilya-api:<exact-release-sha>
KAMILYA_RELEASE_SHA=<exact-40-character-release-sha>
KAMILYA_BIND_IP=10.77.77.2
KAMILYA_FORWARDED_ALLOW_IPS=10.77.77.1
KAMILYA_ENV_FILE=/opt/kamilya-runtime/runtime.env
KAMILYA_BLOB_STORAGE_DIR=/opt/kamilya-runtime/blob-storage

# Required secret name only. Set the value in the root-only deployment env.
VALKEY_PASSWORD=
